#: contrib/session-helper/org.freedesktop.ColorHelper.gschema.xml:5
msgid "Default gamma for the display"
msgstr "Osnovna gama za ekran"

#: contrib/session-helper/org.freedesktop.ColorHelper.gschema.xml:6
msgid ""
"The default target gamma value for the display. Common values are 1.8, 2.2 "
"and 2.4."
msgstr ""
"Osnovna vrednost ciljne game za ekran. Opšte vrednosti su 1.8, 2.2 i 2.4."

#: contrib/session-helper/org.freedesktop.ColorHelper.gschema.xml:13
msgid "Default display target whitepoint"
msgstr "Osnovna bela tačka ciljnog ekrana"

#: contrib/session-helper/org.freedesktop.ColorHelper.gschema.xml:14
msgid ""
"The default target whitepoint in Kelvin for display calibration, with 0 "
"meaning display native. Common values are 6500 for D65 and 5000 for D50."
msgstr ""
"Osnovna ciljna bela tačka u Kelvinima za kalibraciju ekrana, gde 0 znači "
"izvorno ekrana. Opšte vrednosti su 6500 za D65 i 5000 za D50."

#: contrib/session-helper/org.freedesktop.ColorHelper.gschema.xml:22
msgid "Delay between sample intervals"
msgstr "Zastoj između intervala uzorka"

#: contrib/session-helper/org.freedesktop.ColorHelper.gschema.xml:23
msgid ""
"This is the delay between setting the sample color and asking the measuring "
"instrument to take a sample. It is required because both the graphics driver "
"and the display itself introduce latency."
msgstr ""
"Ovo je zastoj između podešavanja boje uzorka i traženja od mernog "
"instrumenta da uzme uzorak. Potrebno je da bi i grafički upravljački program "
"i sam prikaz uveli kašnjenje."

